# FraudLens ML inference service — configuration template.
# Copy to .env (gitignored). The service never reads backend/.env.

# MongoDB is NOT contacted by this service; the backend supplies the case's
# transactions per request. These are kept here only for optional local tooling.
# MONGODB_URI=mongodb://localhost:27017/?directConnection=true

# Model artifact + feature contract (defaults resolve to ml/artifacts/m5/*).
# MODEL_ARTIFACT_PATH=../ml/artifacts/m5/winner_model.joblib
# FEATURE_NAMES_PATH=../ml/artifacts/m5/feature_names.json
# ML_SRC_PATH=../ml/src

# Service port the Node backend talks to.
ML_SERVICE_PORT=8100

# Optional shared secret. When set, the backend must send a matching X-ML-Token.
# ML_SERVICE_TOKEN=change-me
