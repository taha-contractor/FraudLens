# FraudLens backend environment configuration
# Copy this file to .env and fill in real values. Never commit real credentials.

PORT=5000
NODE_ENV=development

# MongoDB connection string (e.g. mongodb+srv://<user>:<password>@<host>/<db>)
MONGODB_URI=

# JWT signing secret - use a strong random value, never commit a real one
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=1h

# Document storage (optional - defaults shown)
# Private directory for uploaded investigation documents, relative to the
# backend working directory unless an absolute path is given.
#   UPLOAD_STORAGE_DIR=./uploads
# Maximum accepted upload size in megabytes.
#   MAX_UPLOAD_SIZE_MB=10

# Analytics conventions (all optional - Milestone 7A read-only analytics)
# Timezone used for transactionHour / night-transaction detection and for the
# DAY / HOUR timeline buckets. Stored timestamps always remain in UTC.
#   ANALYTICS_TIMEZONE=Asia/Kolkata
# Absolute threshold behind the explainable HIGH_VALUE signal.
#   ANALYTICS_HIGH_VALUE_THRESHOLD=50000
# Upper bound on completed transactions scanned per suspicious request.
#   ANALYTICS_MAX_SCAN_TRANSACTIONS=5000
